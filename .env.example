APP_NAME=VibeDietr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80
VITE_PORT=5173
NODE_VERSION=22
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MEILISEARCH_PORT=7700
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vibedietr
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRODUCTION_DURABLE_DISK=
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_RETRY_AFTER=90
QUEUE_OPERATIONS_ENABLED=false
QUEUE_SUPERVISION=local
QUEUE_SCHEDULER_ENABLED=false

# Provider-neutral DEP-05 defaults. Production must configure a platform/hosted collector.
OBSERVABILITY_ADAPTER=local
OBSERVABILITY_RELEASE=development
OBSERVABILITY_ALERT_RECIPIENT_ROLE=primary_administrator
OBSERVABILITY_WORKER_STALE_SECONDS=180
OBSERVABILITY_SCHEDULER_STALE_SECONDS=180
OBSERVABILITY_PRUNE_STALE_SECONDS=93600
OBSERVABILITY_QUEUE_DEPTH_WARNING=25
OBSERVABILITY_QUEUE_DEPTH_CRITICAL=100
OBSERVABILITY_OLDEST_JOB_WARNING_SECONDS=300
OBSERVABILITY_OLDEST_JOB_CRITICAL_SECONDS=900
OBSERVABILITY_PROVIDER_SLOW_WARNING_MS=3000
OBSERVABILITY_FAILURE_WINDOW_SECONDS=300
OBSERVABILITY_FAILURE_WARNING_COUNT=5
OBSERVABILITY_FAILURE_CRITICAL_COUNT=20

CACHE_STORE=database
# CACHE_PREFIX=

TRUSTED_HOSTS=
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADERS=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=
POSTMARK_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# OpenFoodFacts read access (no credential required)
# Configure a real application version and public contact URL/email in production.
OPENFOODFACTS_USER_AGENT="VibeDietr/development (http://localhost)"
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_API_VERSION=v3.4
OPENFOODFACTS_CONNECT_TIMEOUT=2
OPENFOODFACTS_TIMEOUT=5
OPENFOODFACTS_ATTEMPTS=2
OPENFOODFACTS_BACKOFF_MS=100
OPENFOODFACTS_MAX_RETRY_AFTER=1

# Administrator security (local-safe defaults; production readiness rejects them)
ADMIN_SECURITY_FINGERPRINT_KEY=
ADMIN_TOTP_ENABLED=true
ADMIN_TOTP_ISSUER=VibeDietr
ADMIN_PASSWORD_ONLY_FALLBACK=false
ADMIN_SECURITY_MAILER=log
ADMIN_SECURITY_PROVIDER=
ADMIN_SECURITY_SENDER_VERIFIED=false
ADMIN_SECURITY_QUEUE=security-notifications
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_ENVIRONMENT=
ADMIN_BOOTSTRAP_TARGET_EMAIL=
ADMIN_BOOTSTRAP_OPERATOR_REFERENCE=
ADMIN_BREAK_GLASS_ENABLED=false
ADMIN_BREAK_GLASS_ENVIRONMENT=
ADMIN_BREAK_GLASS_REPLACEMENT_EMAIL=
ADMIN_BREAK_GLASS_COMPROMISED_EMAIL=
ADMIN_BREAK_GLASS_OPERATOR_REFERENCE=
APP_INSTANCE=local

# DEC-005 local recipe-import configuration (feature is disabled by default)
RECIPE_IMPORTS_ENABLED=false
RECIPE_IMPORT_FORMATS=txt,md,html
RECIPE_IMPORT_MAX_UPLOAD_BYTES=2097152
RECIPE_IMPORT_MAX_URL_LENGTH=2048
RECIPE_IMPORT_MAX_REDIRECTS=5
RECIPE_IMPORT_CONNECT_TIMEOUT=3
RECIPE_IMPORT_TIMEOUT=15
RECIPE_IMPORT_QUEUE=default
RECIPE_IMPORT_ATTEMPTS=3
RECIPE_IMPORT_BACKOFF_SECONDS=10,60
RECIPE_IMPORT_CONCURRENCY=2
RECIPE_IMPORT_PER_USER_PER_HOUR=10
RECIPE_IMPORT_TRANSIENT_DISK=
RECIPE_IMPORT_CLEANUP_HOURS=24
RECIPE_IMPORT_PARSER_VERSION=

# DEC-006 local OCR and optional Google fallback (both disabled by default)
OCR_ENABLED=false
OCR_TESSERACT_VERSION=
OCR_LANGUAGE=
OCR_HEIC_DECODER_VERSION=
OCR_PREPROCESSING_VERSION=
OCR_MAX_UPLOAD_BYTES=20971520
OCR_MAX_MEGAPIXELS=50
OCR_MAX_IMAGES=1
OCR_QUEUE=default
OCR_ATTEMPTS=3
OCR_TIMEOUT=60
OCR_CONCURRENCY=2
OCR_TRANSIENT_DISK=
OCR_CLEANUP_HOURS=24
OCR_GOOGLE_FALLBACK_ENABLED=false
OCR_GOOGLE_PROJECT_ID=
OCR_GOOGLE_LOCATION=eu
OCR_GOOGLE_ENDPOINT=
OCR_GOOGLE_PROCESSOR_ID=
OCR_GOOGLE_MODEL_VERSION=
GOOGLE_APPLICATION_CREDENTIALS=
OCR_GOOGLE_TIMEOUT=30
OCR_GOOGLE_MONTHLY_PAGE_QUOTA=0
OCR_GOOGLE_MONTHLY_BUDGET_MINOR=0
