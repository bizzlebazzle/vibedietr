{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "env:check": "node scripts/validate-development-environment.mjs",
        "docs:check": "npm run docs:lint && npm run docs:links && npm run docs:decisions",
        "docs:decisions": "node scripts/docs/validate-decisions.mjs",
        "docs:links": "markdown-link-check --config .markdown-link-check.json ./*.md docs .github",
        "docs:lint": "markdownlint-cli2",
        "docs:test": "node --test tests/Documentation/*.test.mjs",
        "test:scanner": "node --test tests/Frontend/*.test.mjs"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "markdown-link-check": "3.15.0",
        "markdownlint-cli2": "0.23.2",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.4"
    },
    "dependencies": {
        "@zxing/library": "0.20.0"
    }
}
