{
    "config": {
        "default": true,
        "MD013": {
            "line_length": 120,
            "code_blocks": false,
            "tables": false,
            "headings": false
        },
        "MD024": {
            "siblings_only": true
        },
        "MD033": {
            "allowed_elements": [
                "a",
                "img",
                "p"
            ]
        },
        "MD036": false,
        "MD041": false
    },
    "globs": [
        "*.md",
        "docs/**/*.md",
        ".github/**/*.md"
    ],
    "ignores": [
        "node_modules/**",
        "vendor/**"
    ]
}
